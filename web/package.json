{
	"name": "baleia-web",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"gen:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable localStorage preferredLanguage baseLocale --emit-ts-declarations",
		"check": "npm run gen:i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-i18n.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest": "npm run gen:i18n",
		"test": "vitest run",
		"test:watch": "vitest",
		"gen:api": "openapi-typescript ../api/swagger.yaml -o src/lib/api/schema.d.ts",
		"e2e": "playwright test",
		"e2e:install": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "3.2.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"msw": "^3.0.4",
		"openapi-msw": "^2.1.1",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.1.4",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.15",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/monoton": "^5.3.0",
		"@fontsource/sometype-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@maltzsama/lang-sql": "^6.12.1",
		"apache-arrow": "^21.2.0",
		"codemirror": "^6.0.2",
		"dompurify": "^3.4.17",
		"idb-keyval": "^6.3.0",
		"luxon": "^3.7.2",
		"marked": "^18.1.3",
		"openapi-fetch": "^0.17.0",
		"sqlingo": "^0.12.4"
	}
}
