# Copy to .env and adjust for your environment.
# Compose reads these variables via ${VAR:-default}.

# Secret used to sign JWTs. Must be a non-default, high-entropy value: the API
# and worker refuse to start with an empty or default secret. Override in
# production.
# JWT_SECRET=replace-with-a-long-random-value

# Key that encrypts stored connection credentials (>= 32 characters, different
# from JWT_SECRET). Rotating JWT_SECRET does not affect it. To rotate this key,
# set the new value here and move the old one to BALEIA_ENCRYPTION_KEY_PREVIOUS.
# BALEIA_ENCRYPTION_KEY=replace-with-a-different-long-random-value
# BALEIA_ENCRYPTION_KEY_PREVIOUS=

# Authentication token lifetimes and password-hashing cost. Unset values use the
# defaults shown. Access tokens are short-lived; refresh tokens rotate on every
# use and are revoked by password/role/account changes. BALEIA_BCRYPT_COST must
# be between 10 and 31.
# BALEIA_ACCESS_TOKEN_TTL=15m
# BALEIA_REFRESH_TOKEN_TTL=720h
# BALEIA_RESET_TOKEN_TTL=30m
# BALEIA_BCRYPT_COST=12

# Trino version. The baleia-catalog-store plugin is compiled against the
# Trino 482 SPI. Changing it requires recompiling the plugin against the new
# SPI version.
TRINO_VERSION=482

# Path to the cloned/built baleia-trino-catalog-store plugin.
# Default: .plugin/baleia-trino-catalog-store (cloned automatically by make)
# BALEIA_PLUGIN_DIR=./.plugin/baleia-trino-catalog-store

# Password for the baleia_trino role in Baleia's PostgreSQL. The API sets the
# role password from this value at boot, and the baleia-trino-catalog-store
# plugin reads the same variable for its Trino connection — one source for both.
# BALEIA_TRINO_DB_PASSWORD=change_before_deploy

# Trino identities. The admin runs catalog DDL/reconcile/maintenance and is
# never used for user SQL. User queries run as the mapped Baleia user identity.
# BALEIA_TRINO_ADMIN_USER=baleia_admin
# BALEIA_TRINO_SERVICE_USER=baleia
# BALEIA_TRINO_USER_IDENTITY=uuid   # uuid -> u_<uuid>, or email

# Per-statement execution timeout (Go duration: 30m, 1h30m). Bounds a single
# statement both in Temporal (activity StartToCloseTimeout) and on the cluster
# (sent to Trino as the session property query_max_execution_time). Minimum 1m.
# BALEIA_STATEMENT_TIMEOUT=30m
# BALEIA_EXECUTION_TIMEOUT=2h
# BALEIA_METADATA_SYNC_INTERVAL=15m
# BALEIA_RECONCILE_INTERVAL=
# BALEIA_RECONCILE_MAX_ACTIONS=20

# Result caps per statement. When a cap is reached the remaining query is
# killed and the result is marked truncated (the UI shows what was buffered).
# BALEIA_RESULT_MAX_ROWS=1000000
# BALEIA_RESULT_MAX_BYTES=536870912

# Whether the worker ensures its recurring Temporal Schedules at boot
# (Lens pollers, table health, retriever dispatcher). Disable in tests/dev
# without a Temporal server.
# BALEIA_SCHEDULES_ENABLED=true

# Network safety for connections (docs/adr/0011). Baleia never dials loopback,
# link-local (including cloud metadata 169.254.169.254) or 0.0.0.0/8.
# BALEIA_CONNECTIONS_DENY_CIDRS=10.20.0.0/16          # extra ranges to refuse
# BALEIA_CONNECTIONS_ALLOW_CIDRS=10.0.0.0/8           # if set, only these
# BALEIA_CONNECTIONS_ALLOW_LOOPBACK=false             # dev only: databases on localhost

# SQLite connections (docs/adr/0011): files must live under this directory,
# visible to both api and worker. Unset disables the SQLite provider.
# BALEIA_SQLITE_ROOT=/data/sqlite
# BALEIA_SQLITE_ALLOW_WRITE=false

# Glue connections (#86): by default a Glue connection must carry explicit keys
# or a role ARN and never uses the host's default AWS credential chain. Set
# this to true to let a connection with neither run under the platform's IAM
# role (operator decision, documented).
# BALEIA_ALLOW_AMBIENT_AWS_CREDENTIALS=false

# Metrics (#87): /metrics on the API and on the worker's listener.
# BALEIA_METRICS_ENABLED=true
# BALEIA_METRICS_TOKEN=
# BALEIA_WORKER_METRICS_ADDR=:9090

# Distributed tracing (#47): off by default. The OTLP endpoint and service name
# come from the standard OpenTelemetry variables. See docs/observability.md.
# BALEIA_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=baleia

# Agents (#59): off by default. Enabling mounts the agent management API and,
# once #58 lands, the read-only MCP server at /mcp. Tokens are `bal_agt_`
# bearer credentials valid only on /mcp.
# BALEIA_AGENTS_ENABLED=false
# BALEIA_AGENT_TOKEN_DEFAULT_TTL=720h
# BALEIA_AGENT_TOKEN_MAX_TTL=2160h

# Agent policy ceilings (#60). A stored policy above a ceiling is rejected on
# save and clamped again when the gate evaluates it.
# BALEIA_AGENT_MAX_ROWS=5000
# BALEIA_AGENT_MAX_RESULT_BYTES=1048576
# BALEIA_AGENT_MAX_QUERY_RUNTIME_SECONDS=900
# BALEIA_AGENT_MAX_CONCURRENT_QUERIES=10
# BALEIA_AGENT_MAX_QUERIES_PER_HOUR=2000
# BALEIA_AGENT_MAX_TOOL_CALLS_PER_MINUTE=600

# Allowed Origin values for /mcp (comma-separated). Empty rejects any request
# carrying an Origin header; native MCP clients do not send one.
# BALEIA_MCP_ALLOWED_ORIGINS=https://app.example.com
# Baleia's database pool (defaults: api 20, worker 10 connections).
# BALEIA_DB_MAX_CONNS=
# BALEIA_DB_MIN_CONNS=2
# BALEIA_DB_MAX_CONN_LIFETIME=1h

# Audit export to an OpenSearch/Elasticsearch-compatible store (#50). Off when
# the URL is unset. The index prefix gets a monthly suffix (baleia-audit-YYYY.MM).
# BALEIA_AUDIT_EXPORT_URL=https://opensearch:9200
# BALEIA_AUDIT_EXPORT_INDEX=baleia-audit
# BALEIA_AUDIT_EXPORT_AUTH=none            # none|basic|bearer|api_key
# BALEIA_AUDIT_EXPORT_USER=
# BALEIA_AUDIT_EXPORT_PASSWORD=
# BALEIA_AUDIT_EXPORT_TOKEN=
# BALEIA_AUDIT_EXPORT_BATCH=500
# BALEIA_AUDIT_EXPORT_INTERVAL=30s
# BALEIA_AUDIT_EXPORT_CA_FILE=

# External secret references (#31): a connection credential may be
# @baleia-secret[env:VAR] or @baleia-secret[file:name]. Baleia resolves env:
# from its environment and file: under this directory; the Trino plugin (v0.9.2+)
# resolves the same reference from Trino's environment. See docs/secrets.md.
# BALEIA_SECRET_FILE_BASE_DIR=/run/secrets
