# Copy to .env and adjust for your environment.
# Compose reads these variables via ${VAR:-default}.

# Trino version. The baleia-catalog-store plugin is compiled against the
# Trino 482 SPI. Changing it requires recompiling the plugin against the new
# SPI version.
TRINO_VERSION=482

# Path to the cloned/built baleia-trino-catalog-store plugin.
# Default: .plugin/baleia-trino-catalog-store (cloned automatically by make)
# BALEIA_PLUGIN_DIR=./.plugin/baleia-trino-catalog-store

# Password for the baleia_trino role in Baleia's PostgreSQL. Used by the plugin
# to read trino_catalog_registry. Must match the password configured in initdb
# or migration 00018.
# BALEIA_TRINO_DB_PASSWORD=change_before_deploy
