# Copie para .env e ajuste para o seu ambiente.
# O compose lê estas variáveis via ${VAR:-default}.

# Versão do Trino. O plugin baleia-catalog-store é compilado contra a API do
# Trino 482. Mudar requer recompilar o plugin contra a nova versão do SPI.
TRINO_VERSION=482

# Caminho para o repositório irmão baleia-trino-catalog-store compilado.
# Padrão: ../baleia-trino-catalog-store
# BALEIA_PLUGIN_DIR=../baleia-trino-catalog-store

# Senha da role baleia_trino no PostgreSQL do Baleia. Usada pelo plugin para
# ler a trino_catalog_registry. Deve bater com a senha configurada no initdb
# ou migration 00018.
# BALEIA_TRINO_DB_PASSWORD=change_before_deploy
