# Local debugging override: publish Trino on the host so you can query it
# directly (e.g. `docker compose exec trino trino`). Trino requires HTTPS and
# the BALEIA_TRINO_PASSWORD login of baleia_admin (#647); trust the CA in the
# trino_ca volume.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up -d trino
#
# The default stack keeps Trino private (expose only); this override is opt-in.
services:
  trino:
    ports:
      - "8443:8443"