meta {
  name: Grant Catalog Access (foreign user -> 404)
  type: http
  seq: 7
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/catalog-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{other_token}}
}

body:json {
  {
    "catalog_id": "00000000-0000-4000-8000-000000000001",
    "permission": "read"
  }
}

assert {
  res.status: eq 404
}

docs {
  The workspace is not the outsider's, so it is refused before the catalog id
  is looked at: any well-formed id will do.
}
