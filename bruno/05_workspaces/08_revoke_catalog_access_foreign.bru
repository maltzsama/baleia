meta {
  name: Revoke Catalog Access (foreign user -> 404)
  type: http
  seq: 8
}

delete {
  url: {{base_url}}/workspaces/{{workspace_id}}/catalog-access/00000000-0000-4000-8000-000000000001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{other_token}}
}

assert {
  res.status: eq 404
}

docs {
  The workspace is not the outsider's, so it is refused before the catalog id
  is looked at: any well-formed id will do.
}
