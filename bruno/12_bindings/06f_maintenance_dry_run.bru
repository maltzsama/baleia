meta {
  name: Maintenance - Dry run
  type: http
  seq: 12
}

post {
  url: {{base_url}}/catalogs/{{lifecycle_catalog_id}}/tables/default/t/maintenance/dry-run
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}



assert {
  res.status: eq 200
  res.body.plan.length: eq 4
}

docs {
  The plan of the four operations, without running anything; recorded as a
  dry_run run (#500).
}
