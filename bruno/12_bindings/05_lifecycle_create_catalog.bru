meta {
  name: Lifecycle - Registered Catalog Is Synced
  type: http
  seq: 5
}

get {
  url: {{base_url}}/catalogs/{{lifecycle_catalog_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.sync_status: eq synced
}

docs {
  The catalog was registered with its connection in the previous case (ADR
  0029); the engine has applied it by now.
}
