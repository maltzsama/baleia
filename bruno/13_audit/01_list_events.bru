meta {
  name: List Audit Events (admin)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/audit/events?limit=20&from={{audit_from}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // The list needs a time window unless it is narrowed by resource or
  // actor (#49): the last day covers this run.
  bru.setVar("audit_from", new Date(Date.now() - 24 * 3600 * 1000).toISOString());
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

docs {
  The append-only audit trail (#45), newest first: an admin sees every
  event. Pass `next_cursor` as `cursor` for the next page. Call sites are
  instrumented by #43.
}
