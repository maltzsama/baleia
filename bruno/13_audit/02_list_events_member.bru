meta {
  name: List Audit Events (member sees only their own)
  type: http
  seq: 2
}

get {
  url: {{base_url}}/audit/events?limit=20&from={{audit_from}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{other_token}}
}

script:pre-request {
  // The list needs a time window unless it is narrowed by resource or
  // actor (#49): the last day covers this run.
  bru.setVar("audit_from", new Date(Date.now() - 24 * 3600 * 1000).toISOString());
}

assert {
  res.status: eq 200
}

tests {
  test("every event is the caller's", function () {
    for (const e of res.body.items) {
      expect(e.actor_kind).to.equal("user");
    }
  });
}
