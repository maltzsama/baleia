meta {
  name: Test Draft Connection (bad password)
  type: http
  seq: 17
}

post {
  url: {{base_url}}/catalog-connections/test
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Draft PostgreSQL",
    "type": "postgresql",
    "config": {
      "host": "{{postgres_host}}",
      "port": "5432",
      "database": "baleia",
      "sslmode": "disable",
      "username": "baleia"
    },
    "credentials": {
      "password": "wrong-password"
    },
    "intents": ["metadata"]
  }
}

assert {
  res.status: eq 200
  res.body.success: eq false
  res.body.error_code: eq auth_failed
}
