meta {
  name: Create Catalog Connection (kind without a provider)
  type: http
  seq: 15
}

post {
  url: {{base_url}}/catalog-connections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Doris",
    "type": "doris",
    "config": {}
  }
}

assert {
  res.status: eq 422
  res.body.code: eq provider_unsupported
}

docs {
  Doris and StarRocks are planned after v1 (#21, #30): a connection of a
  planned type is rejected with provider_unsupported.
}
