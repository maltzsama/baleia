meta {
  name: Create Catalog Connection (PostgreSQL)
  type: http
  seq: 14
}

post {
  url: {{base_url}}/catalog-connections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Local PostgreSQL",
    "type": "postgresql",
    "access_mode": "direct",
    "config": {
      "host": "{{postgres_host}}",
      "port": "5432",
      "database": "baleia",
      "sslmode": "disable",
      "username": "baleia"
    },
    "credentials": {
      "password": "baleia"
    }
  }
}

assert {
  res.status: eq 201
  res.body.url: eq jdbc:postgresql://{{postgres_host}}:5432/baleia
  res.body.access_mode: eq direct
  res.body.engine.class: eq direct
  res.body.engine.kind: eq postgresql
  res.body.engine.name: eq local_postgresql
  res.body.catalogs: length 1
}

vars:post-response {
  postgresql_connection_id: res.body.id
  engine_id: res.body.engine.id
}

docs {
  A direct connection owns its native engine (ADR 0029). The engine, its
  native catalog (the configured database) and the binding are created with
  the connection in one transaction. The engine is named after the connection.
}
