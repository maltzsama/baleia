meta {
  name: Update Catalog Connection
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/catalog-connections/{{catalog_connection_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Local Polaris Updated",
    "credentials_read_only": false
  }
}

assert {
  res.body.credentials_read_only: eq false
}
