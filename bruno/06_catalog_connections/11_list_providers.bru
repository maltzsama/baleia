meta {
  name: List Connection Providers
  type: http
  seq: 11
}

get {
  url: {{base_url}}/connection-providers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

docs {
  Every connection kind with its roles and config schema. Fields with
  `secret: true` go in `credentials` and are never returned.
}
