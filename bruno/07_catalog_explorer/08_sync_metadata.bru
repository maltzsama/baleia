meta {
  name: Sync Catalog Metadata
  type: http
  seq: 8
}

post {
  url: {{base_url}}/catalogs/{{explorer_catalog_id}}/metadata/sync
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // 09 waits for a pass newer than the ones already recorded.
  const axios = require("axios");
  const url = bru.getEnvVar("base_url") + "/catalogs/" + bru.getVar("explorer_catalog_id") + "/metadata/sync-runs?limit=1";
  const r = await axios.get(url, { headers: { Authorization: "Bearer " + bru.getVar("token") } });
  bru.setVar("metadata_newest_run_before", r.data.length > 0 ? r.data[0].id : "");
}

script:post-response {
  bru.setVar("metadata_sync_started", res.status === 202);
}

assert {
  res.status: in 202,409
}

docs {
  Starts one metadata pass of the catalog on the worker (#15): namespaces,
  tables and columns are read from the catalog's own source (here Polaris)
  and stored once per catalog. 409 `sync_in_progress` while a pass of the
  same catalog runs (creating the catalog already started one, #17). Owner
  of the connection or admin only.
}
