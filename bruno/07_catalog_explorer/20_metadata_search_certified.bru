meta {
  name: Metadata Search — certified filter
  type: http
  seq: 20
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/metadata/search?q={{metadata_table_name}}&certified=yes&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the response is a list", function () {
    expect(res.body).to.be.an("array");
  });
}

docs {
  `certified` filters by the `certified` tag (#534).
}
