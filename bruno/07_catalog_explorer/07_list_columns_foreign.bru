meta {
  name: List Columns (foreign user -> 404)
  type: http
  seq: 7
}

get {
  url: {{base_url}}/connections/{{catalog_connection_id}}/catalogs/{{catalog_name}}/namespaces/{{namespace_name}}/tables/{{table_name}}/columns
  body: none
  auth: bearer
}

auth:bearer {
  token: {{other_token}}
}

assert {
  res.status: eq 404
}
