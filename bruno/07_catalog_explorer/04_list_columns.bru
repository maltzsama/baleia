meta {
  name: List Columns
  type: http
  seq: 4
}

get {
  url: {{base_url}}/connections/{{catalog_connection_id}}/catalogs/{{catalog_name}}/namespaces/{{namespace_name}}/tables/{{table_name}}/columns
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body[0].name: eq id
}
