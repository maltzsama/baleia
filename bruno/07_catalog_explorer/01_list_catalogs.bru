meta {
  name: List Catalogs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/catalog/{{catalog_connection_id}}/catalogs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body[0].name: eq baleia
}

vars:post-response {
  catalog_name: res.body[0].name
}
