meta {
  name: Invite Member for Teams
  type: http
  seq: 0
}

post {
  url: {{base_url}}/users/invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // A fresh address each run: an invite of an existing e-mail is a 409 and
  // would leave team_member_id unset. 99_cleanup removes the user.
  bru.setVar("team_member_email", `member_teams_${Date.now()}@baleia.io`);
}

body:json {
  {
    "email": "{{team_member_email}}",
    "role": "member"
  }
}

assert {
  res.status: eq 201
}

vars:post-response {
  team_member_id: res.body.id
}