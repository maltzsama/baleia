meta {
  name: Grant the destination for writing
  type: http
  seq: 0
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/catalog-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "catalog_id": "{{explorer_catalog_id}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  A retriever writes to an active Iceberg binding granted to the workspace
  (#118, #651). The grant is an upsert, so the case can run again.
}
