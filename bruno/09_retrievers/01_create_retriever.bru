meta {
  name: Create Retriever
  type: http
  seq: 1
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/retrievers
  body: json
  auth: bearer
}

body:json {
  {
    "name": "bruno_retriever_probe",
    "definition_sql": "SELECT 1 AS id",
    "dest_catalog": "bruno_explorer",
    "dest_namespace": "analytics",
    "dest_table": "bruno_retriever_probe",
    "cron_schedule": "0 */6 * * *",
    "refresh_type": "full"
  }
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 201
  res.body.dest_table: eq bruno_retriever_probe
}

vars:post-response {
  retriever_id: res.body.id
}
