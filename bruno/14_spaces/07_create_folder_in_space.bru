meta {
  name: Create Folder in Space
  type: http
  seq: 7
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Space Folder",
    "space_id": "{{space_id}}"
  }
}

assert {
  res.status: eq 201
  res.body.space_id: eq {{space_id}}
}

vars:post-response {
  space_folder_id: res.body.id
}
