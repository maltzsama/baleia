meta {
  name: MCP tools/list
  type: http
  seq: 2
}

post {
  url: {{base_url}}/../mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{agent_token_secret}}
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/list",
    "params": {}
  }
}

assert {
  res.status: eq 200
}

tests {
  test("the v1 registry is exposed", function () {
    expect(res.body.result.tools).to.be.an("array");
    expect(res.body.result.tools.length).to.eq(12);
  });
}
