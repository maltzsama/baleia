meta {
  name: MCP initialize
  type: http
  seq: 1
}

post {
  url: {{base_url}}/../mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{agent_token_secret}}
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-06-18",
      "capabilities": {},
      "clientInfo": { "name": "bruno", "version": "1" }
    }
  }
}

assert {
  res.status: eq 200
}
