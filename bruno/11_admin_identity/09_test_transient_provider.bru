meta {
  name: Test Unsaved Identity Provider
  type: http
  seq: 9
}

post {
  url: {{base_url}}/admin/identity-providers/test
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "oidc",
    "oidc": {
      "issuer_url": "https://idp.example.test",
      "client_id": "baleia-bruno",
      "client_secret": "bruno-oidc-secret"
    }
  }
}

assert {
  res.status: eq 200
  res.body.ok: isBoolean
}

tests {
  test("a transient probe writes nothing and echoes no secret", function () {
    expect(JSON.stringify(res.body)).to.not.contain("bruno-oidc-secret");
  });
}

docs {
  An unsaved configuration can be validated before saving (#286).
}
