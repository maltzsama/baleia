meta {
  name: Delete Identity Provider
  type: http
  seq: 10
}

delete {
  url: {{base_url}}/admin/identity-providers/{{idp_id}}?suspend_users=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Linked users make a delete a 409 unless suspend_users=true; those users are
  suspended and detached, never orphaned (#285).
}
