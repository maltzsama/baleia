meta {
  name: Create First Admin
  type: http
  seq: 2
}

post {
  url: {{base_url}}/setup/admin
  body: json
  auth: none
}

headers {
  X-Baleia-Client: api
}

body:json {
  {
    "name": "Admin",
    "email": "admin@baleia.io",
    "password": "admin123456"
  }
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}
