meta {
  name: Refresh Token
  type: http
  seq: 12
}

post {
  url: {{base_url}}/auth/refresh
  body: json
  auth: none
}

headers {
  X-Baleia-Client: api
  X-Requested-With: baleia
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}
