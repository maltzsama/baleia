meta {
  name: List Auth Providers
  type: http
  seq: 12
}

get {
  url: {{base_url}}/auth/providers
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("the login list carries no configuration", function () {
    expect(res.body).to.be.an("array");
    const raw = JSON.stringify(res.body);
    expect(raw).to.not.contain("config");
    expect(raw).to.not.contain("secret");
  });
}

docs {
  Public list of enabled OIDC and LDAP providers (#289).
}
