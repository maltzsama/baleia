meta {
  name: Login after reset
  type: http
  seq: 10
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  X-Baleia-Client: api
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}

docs {
  A password reset revokes every session of the account, including the
  token the earlier requests used. Signing in again lets the rest of the
  collection run.
}
