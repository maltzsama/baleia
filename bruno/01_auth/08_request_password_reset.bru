meta {
  name: Request Password Reset
  type: http
  seq: 8
}

post {
  url: {{base_url}}/auth/password-reset/request
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getEnvVar("admin_email")) {
    throw new Error("Set admin_email in the Bruno environment");
  }
  bru.setVar("reset_requested_at", new Date().toISOString());
}

body:json {
  {
    "email": "{{admin_email}}"
  }
}

assert {
  res.status: eq 204
}

script:post-response {
  // Pull the reset token out of the email Mailpit captured, so the next
  // request can complete the flow end to end. The e-mail is sent in the
  // background (#422): wait for one newer than the request.
  const axios = require("axios");
  const mailpit = bru.getEnvVar("mailpit_url");
  const adminEmail = bru.getEnvVar("admin_email");
  const since = new Date(bru.getVar("reset_requested_at")).getTime() - 1000;
  let id = "";
  for (let i = 0; i < 20 && !id; i++) {
    const list = await axios.get(mailpit + "/api/v1/search", { params: { query: "to:" + adminEmail, limit: 1 } });
    const latest = list.data.messages[0];
    if (latest && new Date(latest.Created).getTime() >= since) id = latest.ID;
    else await new Promise((resolve) => setTimeout(resolve, 500));
  }
  const msg = await axios.get(mailpit + "/api/v1/message/" + id);
  const match = (msg.data.Text || "").match(/token=([^\s]+)/);
  bru.setVar("reset_token", match ? match[1] : "");
}
