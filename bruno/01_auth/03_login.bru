meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  X-Baleia-Client: api
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}
