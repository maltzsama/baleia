meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  X-Baleia-Client: api
}

script:pre-request {
  if (!bru.getEnvVar("admin_email") || !bru.getEnvVar("admin_password")) {
    throw new Error("Set admin_email and admin_password in the Bruno environment");
  }
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}
