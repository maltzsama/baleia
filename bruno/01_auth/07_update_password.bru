meta {
  name: Update Password
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("admin_password") || !bru.getEnvVar("admin_password_new")) {
    throw new Error("Set admin_password and admin_password_new in the Bruno environment");
  }
}

body:json {
  {
    "current_password": "{{admin_password}}",
    "new_password": "{{admin_password_new}}"
  }
}
