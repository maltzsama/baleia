meta {
  name: Update Password
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // Optional: skipped, not failed, when the environment does not set it up.
  if (!bru.getEnvVar("admin_password") || !bru.getEnvVar("admin_password_new")) {
    bru.runner.skipRequest();
    return;
  }
}

body:json {
  {
    "current_password": "{{admin_password}}",
    "new_password": "{{admin_password_new}}"
  }
}
