meta {
  name: Confirm Password Reset
  type: http
  seq: 9
}

post {
  url: {{base_url}}/auth/password-reset/confirm
  body: json
  auth: none
}

script:pre-request {
  if (!bru.getVar("reset_token") || !bru.getEnvVar("admin_password")) {
    throw new Error("Run the reset request first and set admin_password in the environment");
  }
}

body:json {
  {
    "token": "{{reset_token}}",
    "new_password": "{{admin_password}}"
  }
}

assert {
  res.status: eq 204
}
