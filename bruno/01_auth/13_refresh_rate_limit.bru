meta {
  name: Refresh Rate Limit
  type: http
  seq: 13
}

post {
  url: {{base_url}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "invalid-token-to-trigger-rate-limit"
  }
}

script:pre-request {
  // The limiter allows a burst (RATE_LIMIT_BURST, default 10) per client
  // address and refills at RATE_LIMIT_RPS: spend it all at once, so the
  // refill cannot keep up and this request is the one refused.
  const axios = require("axios");
  const url = bru.getEnvVar("base_url") + "/auth/refresh";
  await Promise.all(Array.from({ length: 30 }, () =>
    axios.post(url, { refresh_token: "invalid-token-to-trigger-rate-limit" }, { validateStatus: () => true })));
}

assert {
  res.status: eq 429
}

docs {
  Spends the refresh limiter's burst, then expects 429. The limiter refills
  at RATE_LIMIT_RPS, so later requests are not affected.
}
