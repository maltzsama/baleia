meta {
  name: Export Space
  type: http
  seq: 2
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/spaces/{{bundle_space_id}}/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.format: eq baleia.bundle
  res.body.format_version: eq 1
}

docs {
  Repeated exports of unchanged content are byte-identical: no ids, no
  timestamps, no secrets.
}
