meta {
  name: Create Bundle Space
  type: http
  seq: 1
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/spaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bundle Space",
    "visibility": "workspace"
  }
}

assert {
  res.status: eq 201
}

vars:post-response {
  bundle_space_id: res.body.id
}
