meta {
  name: List Service Accounts
  type: http
  seq: 2
}

get {
  url: {{base_url}}/service-accounts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("the created account is listed", function () {
    expect(res.body.map((s) => s.id)).to.include(bru.getVar("service_account_id"));
  });
}
