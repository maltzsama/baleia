meta {
  name: Create Service Account
  type: http
  seq: 1
}

post {
  url: {{base_url}}/service-accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno bot",
    "description": "Created by the Bruno collection"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq active
}

vars:post-response {
  service_account_id: res.body.id
}
