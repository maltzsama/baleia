meta {
  name: Docs on Ungranted Catalog (404)
  type: http
  seq: 6
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/semantic/docs?catalog_id=00000000-0000-4000-8000-000000000001&ns=analytics&table=events
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
}

docs {
  A catalog the workspace cannot use is invisible: 404, never 403 and never
  an existence oracle.
}
