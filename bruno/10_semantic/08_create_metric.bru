meta {
  name: Create Metric
  type: http
  seq: 8
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/semantic/metrics
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "slug": "events_count",
    "label": "Events count",
    "description": "How many events were tracked.",
    "certified": true,
    "catalog_id": "{{explorer_catalog_id}}",
    "namespace": ["analytics"],
    "table": "events",
    "definition": { "type": "simple", "aggregation": "count" }
  }
}

assert {
  res.status: eq 201
  res.body.slug: eq events_count
  res.body.format_version: eq 1
}

vars:post-response {
  metric_id: res.body.id
}

docs {
  The API renders the metric for the chosen binding and probes it with a
  zero-row read-only statement in the caller's identity; an invalid column is
  a 422 with the engine's code.
}
