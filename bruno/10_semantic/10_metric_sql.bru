meta {
  name: Render Metric SQL
  type: http
  seq: 10
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/semantic/metrics/{{metric_id}}/sql
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.portable: eq true
}

docs {
  Renders for the metric's binding (or the catalog's first enabled one) in
  that engine's dialect. Grain/from/to add the time axis.
}
