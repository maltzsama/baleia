meta {
  name: List Agent Tokens
  type: http
  seq: 6
}

get {
  url: {{base_url}}/agents/{{agent_id}}/tokens
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the list never returns a secret", function () {
    expect(res.body[0].token).to.be.undefined;
    expect(res.body[0].prefix).to.be.a("string");
  });
}
