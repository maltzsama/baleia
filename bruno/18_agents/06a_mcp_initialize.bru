meta {
  name: MCP initialize
  type: http
  seq: 7
}

post {
  url: {{mcp_url}}
  body: json
  auth: none
}

script:pre-request {
  // /mcp is served next to /api/v1, not under it; a literal ".." in the URL
  // reaches the server as is and does not match the route.
  bru.setVar("mcp_url", bru.getEnvVar("base_url").replace(/\/api\/v1\/?$/, "") + "/mcp");
}

headers {
  Authorization: Bearer {{agent_token_secret}}
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-06-18",
      "capabilities": {},
      "clientInfo": { "name": "bruno", "version": "1" }
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  The MCP server (#59) answers on /mcp with the agent token created above,
  before 07 revokes it.
}
