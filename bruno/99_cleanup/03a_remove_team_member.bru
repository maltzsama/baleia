meta {
  name: Remove the teams member
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/users/{{team_member_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  The user 04_teams invited never signed in, so it owns no workspace and is
  removed; each run invites a fresh one.
}
