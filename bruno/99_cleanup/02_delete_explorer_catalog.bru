meta {
  name: Delete Explorer Catalog
  type: http
  seq: 2
}

delete {
  url: {{base_url}}/connections/{{catalog_connection_id}}/catalogs/{{explorer_catalog_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Drops bruno_explorer from Trino and disables its registry row; the
  connection can then be deleted.
}
