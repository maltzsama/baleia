meta {
  name: Logout
  type: http
  seq: 7
}

post {
  url: {{base_url}}/auth/logout
  body: json
  auth: bearer
}

headers {
  X-Requested-With: baleia
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

assert {
  res.status: eq 204
}
docs {
  Last request of the collection: logging out ends the session every other
  request uses.
}
