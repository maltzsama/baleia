meta {
  name: Get Global BI Gateway Switch
  type: http
  seq: 1
}

get {
  url: {{base_url}}/admin/bi-gateway
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.enabled: isBoolean
  res.body.configured: isBoolean
  res.body.state: isString
  res.body.blocked_by: isArray
  res.body.health.status: isString
  res.body.concurrency.max_per_key: isNumber
  res.body.concurrency.max_per_workspace: isNumber
}
