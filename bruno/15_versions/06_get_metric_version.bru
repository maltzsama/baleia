meta {
  name: Get Metric Version
  type: http
  seq: 6
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/semantic/metrics/{{metric_id}}/versions/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.change_kind: eq create
  res.body.snapshot.label: eq Events count
}
