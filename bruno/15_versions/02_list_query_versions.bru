meta {
  name: List Saved Query Versions
  type: http
  seq: 2
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/queries/{{query_id}}/versions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body[0].version: isNumber
}

docs {
  Newest first. The query is deleted, so the role is checked against the last
  version's space.
}
