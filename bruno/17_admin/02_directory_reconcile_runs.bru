meta {
  name: Directory Reconcile Runs
  type: http
  seq: 2
}

get {
  url: {{base_url}}/admin/directory-reconcile-runs?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the list is bounded to runs, newest first", function () {
    expect(res.body).to.be.an("array");
  });
}

docs {
  One row per directory pass; `aborted_safety` means the safety brake refused
  a mass suspension (#257).
}
