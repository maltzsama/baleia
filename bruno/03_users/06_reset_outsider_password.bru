meta {
  name: Set Outsider Password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/auth/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "{{outsider_reset_token}}",
    "new_password": "outsider123456"
  }
}

script:pre-request {
  // Works for a new outsider and for one kept from an earlier run: request a
  // reset and read its token from the e-mail Mailpit captured.
  const axios = require("axios");
  const mailpit = bru.getEnvVar("mailpit_url");
  // The e-mail is sent in the background (#422): wait for one newer than
  // the request.
  const since = Date.now() - 1000;
  await axios.post(bru.getEnvVar("base_url") + "/auth/password-reset/request", { email: "outsider@baleia.io" });
  let id = "";
  for (let i = 0; i < 20 && !id; i++) {
    const list = await axios.get(mailpit + "/api/v1/search", { params: { query: "to:outsider@baleia.io", limit: 1 } });
    const latest = list.data.messages[0];
    if (latest && new Date(latest.Created).getTime() >= since) id = latest.ID;
    else await new Promise((resolve) => setTimeout(resolve, 500));
  }
  const msg = await axios.get(mailpit + "/api/v1/message/" + id);
  const match = (msg.data.Text || "").match(/token=([^\s]+)/);
  bru.setVar("outsider_reset_token", match ? match[1] : "");
}

assert {
  res.status: eq 204
}
