meta {
  name: Reconcile Trino (dry run)
  type: http
  seq: 10
}

post {
  url: {{base_url}}/engines/{{trino_engine_id}}/reconcile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.dry_run: eq true
  res.body.adopted: isArray
  res.body.actions: isArray
}

docs {
  Checks every managed binding of the engine against what it reports
  (#37): dry run by default; pass dry_run=false to apply. Catalogs the
  engine has that Baleia does not manage are reported in `adopted` and
  never dropped. Admins only.
}
