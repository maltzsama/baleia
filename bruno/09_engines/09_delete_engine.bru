meta {
  name: Delete Engine
  type: http
  seq: 9
}

delete {
  url: {{base_url}}/engines/{{engine_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Native catalogs and bindings go with the engine; the connection stays (and
  is deleted by 99_cleanup).
}
