meta {
  name: Create Direct Engine Again Is Refused
  type: http
  seq: 2
}

post {
  url: {{base_url}}/engines
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "local-pg",
    "connection_id": "{{postgresql_connection_id}}"
  }
}

assert {
  res.status: eq 409
}

docs {
  The connection from 06_catalog_connections/14_create_postgresql already owns
  its engine, created with the connection (ADR 0029), so a second registration
  is a conflict.
}
