meta {
  name: Get Execution
  type: http
  seq: 8
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/executions/{{execution_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  `engine_query_id` (formerly `trino_query_id`) is the statement's id on its
  engine. Statements also list their stored `result_sets`
  ({result_index, rows, bytes, truncated}).
}
