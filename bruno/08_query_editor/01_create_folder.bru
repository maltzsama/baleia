meta {
  name: Create Folder
  type: http
  seq: 1
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "My Folder"
  }
}

vars:post-response {
  folder_id: res.body.id
}

assert {
  res.status: eq 201
}
