meta {
  name: List Executions (filtered)
  type: http
  seq: 15
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/executions?status=finished&q=SELECT&limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the history page has data and an optional cursor", function () {
    expect(res.body.data).to.be.an("array");
    expect(res.body).to.have.property("next_cursor");
  });
}
