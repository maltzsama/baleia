meta {
  name: Get Statement Results (paged)
  type: http
  seq: 16
}

get {
  url: {{base_url}}/workspaces/{{workspace_id}}/executions/{{execution_id}}/statements/1/results?offset=0&limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("a paged read returns a small Arrow stream and the total row count", function () {
    expect(res.getHeader("content-type")).to.equal("application/vnd.apache.arrow.stream");
    expect(res.getHeader("x-total-rows")).to.not.be.undefined;
  });
}
