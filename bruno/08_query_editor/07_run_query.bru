meta {
  name: Run Query
  type: http
  seq: 7
}

post {
  url: {{base_url}}/workspaces/{{workspace_id}}/executions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "workspace_id": "{{workspace_id}}",
    "sql": "SELECT 1"
  }
}

script:pre-request {
  // Without a target the API resolves the workspace default or answers 422
  // target_required.
  // Prefer the run's own catalog (07_catalog_explorer/00_create_catalog).
  const catalog = bru.getVar("explorer_catalog_id");
  const binding = bru.getVar("binding_id");
  if (catalog || binding) {
    const body = req.getBody();
    body.target = catalog ? { catalog_id: catalog } : { binding_id: binding };
    req.setBody(body);
  }
}

vars:post-response {
  execution_id: res.body.id
}

assert {
  res.status: eq 202
}
